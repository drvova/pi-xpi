{
  "name": "@xaccefy/pi-xtodo",
  "version": "0.9.4",
  "description": "Simplified todo extension for tracking multi-step progress in Pi Agent",
  "keywords": [
    "pi-package",
    "pi-extension",
    "xpi",
    "todo"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaccefy/pi-xpi.git",
    "directory": "packages/pi-xtodo"
  },
  "homepage": "https://github.com/xaccefy/pi-xpi/tree/main/packages/pi-xtodo#readme",
  "bugs": {
    "url": "https://github.com/xaccefy/pi-xpi/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "pi-xtodo.ts",
    "pi-xtodo.omp.ts",
    "extension.ts",
    "README.md",
    "LICENSE"
  ],
  "main": "pi-xtodo.ts",
  "pi": {
    "extensions": [
      "./pi-xtodo.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./pi-xtodo.omp.ts"
    ]
  },
  "dependencies": {
    "@xaccefy/pi-shared": "0.9.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    }
  }
}
