{
  "name": "@xaccefy/pi-xpi",
  "version": "0.9.4",
  "description": "XPI — offensive security tools for Pi Agent. Casefile tracking with enforced gates, proof-carrying attestations, structural code search, and todo tracking.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "xpi",
    "security",
    "bug-bounty",
    "pentest",
    "ctf",
    "exploit"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaccefy/pi-xpi.git"
  },
  "homepage": "https://github.com/xaccefy/pi-xpi#readme",
  "bugs": {
    "url": "https://github.com/xaccefy/pi-xpi/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "plugin.json",
    ".omp-plugin/",
    "agents/",
    "skills/",
    "schemas/",
    "docs/",
    "packages/pi-casefile/src/",
    "packages/pi-casefile/skills/",
    "packages/pi-casefile/bin/",
    "packages/pi-xtodo/index.ts",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-casefile/src/index.ts",
      "./packages/pi-xtodo/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "omp": {
    "description": "Offensive security toolkit: casefile ledger with honest-PoC gates, proof-carrying attestations, exploit chains, coverage matrix, and todos. Skills (cyberwf, web-pentest, casefile) and the auditor/tracer/skeptic/chain task agents load by convention; web lookup and exploit_search are host-provided.",
    "extensions": [
      "./packages/pi-casefile/src/index.ts",
      "./packages/pi-xtodo/index.ts"
    ],
    "settings": {
      "xpMode": {
        "type": "enum",
        "values": [
          "off",
          "lite",
          "swarm",
          "on"
        ],
        "env": "PI_XP_MODE",
        "description": "Casefile XP (offensive) mode override: swarm (bounded multi-agent pipeline), lite (single-agent), or off. Leave unset to control it per session with the /xp command; a value here overrides /xp."
      },
      "casefilePath": {
        "type": "string",
        "env": "PI_CASEFILE_PATH",
        "description": "Override the SQLite casefile ledger path (default: <workspace>/.pi/casefile.db)."
      },
      "attestKey": {
        "type": "string",
        "env": "PI_ATTEST_KEY",
        "description": "Path to an Ed25519 PKCS#8 PEM private key for signing CaseAttest attestations (unsigned if unset)."
      },
      "attestKeyPem": {
        "type": "string",
        "secret": true,
        "env": "PI_ATTEST_KEY_PEM",
        "description": "Inline Ed25519 PEM private key for signing attestations; takes precedence over attestKey."
      }
    }
  },
  "dependencies": {
    "@xaccefy/pi-shared": "0.9.4",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/bun": "^1.3.14",
    "typebox": "1.1.38",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "scripts": {
    "test": "bun test --isolate",
    "bench": "bun bench/run.ts",
    "test:casefile": "bun test --isolate packages/pi-casefile",
    "test:xtodo": "bun test --isolate packages/pi-xtodo",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "version:patch": "node scripts/bump-version.js patch && bun install --lockfile-only",
    "version:minor": "node scripts/bump-version.js minor && bun install --lockfile-only",
    "version:major": "node scripts/bump-version.js major && bun install --lockfile-only",
    "publish:all": "node scripts/publish-all.js",
    "publish:dry": "npm publish -ws --access public --dry-run"
  }
}
